@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h2>Welcome to Flipkart Clone</h2>
    <p>A simple 3-tier shopping app Update page for Testing121 </p>

    <a class="btn btn-primary m-2"
       asp-controller="Products"
       asp-action="Index">
        View Products
